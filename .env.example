# Soniox API key. Lives only on the venue laptop. Never commit the real .env.
SONIOX_API_KEY=

# Token guarding /admin. Generate a long random string.
ADMIN_TOKEN=

# Public URL the QR code points at (Cloudflare named tunnel hostname).
PUBLIC_URL=http://localhost:8000

# Dollars per streamed minute, used only to show spend on /admin.
# $0.18/hour with two-way translation: $2 per million audio tokens and
# $4 per million text tokens, at roughly 30k of each per hour.
# Source: soniox.com/pricing, checked 2026-10-13.
SONIOX_RATE_PER_MINUTE=0.003

# Credit the whole project has to live inside. $10 at the rate above is
# about 55 hours of streaming.
SONIOX_BUDGET_USD=10
