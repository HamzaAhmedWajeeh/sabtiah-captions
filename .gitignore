# secrets
.env

# session artifacts (never committed, never served)
logs/
recordings/
clips/
eval/out/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# raw Soniox captures: verbatim transcripts of whatever was recorded.
# Committing one is a deliberate act (git add -f), e.g. into tests/fixtures/.
# The analyzer's markdown reports (docs/captures/*.md) quote the transcript too
# and are tracked on purpose: they are the Phase 1 evidence. Same judgment
# applies before making this repo public.
docs/captures/*.jsonl
